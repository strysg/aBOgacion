<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= nombre %> – <%= siteTitle %></title>
  <link rel="stylesheet" href="/assets/style.css">
</head>
<body>
  <header>
    <a href="../index.html" class="home-link">← Volver a la búsqueda</a>
  </header>
  <div class="norm-container">
    <div class="norm-content">
      <% if (estado === 'no vigente') { %>
        <h3 class="no-vigente">No vigente</h3>
      <% } %>
      <%- htmlContent %>
    </div>
    <div class="norm-meta">
      <p>Tipo: <span class="type"><%= tipoNorma %></span></p>
      <p>Enlace: <a class="enlaceNorma" href="<%- enlaceNorma %>"><%= enlaceNorma %></a></p>
      <p>Núm. en Gaceta: <code><%= nroEnGaceta %></code></p>
      <p>Extraído de: <i><%= fuente %></i></p>
      <p>Estado:
        <% if (estado === 'vigente') { %>
          <strong>vigente</strong>
        <% } else if (estado === 'no vigente') { %>
        <code>No vigente</code>
      <% } %>
      <p>Mes/Año: <span class="mesAnio"><%= mesAnio.split('/')[0] %></span> <a href="/<%= year %>"><%= year %></a></p>
      <p>Fecha: <span class="fecha"><%= fecha %></span></p>
      </p>
    </div>
  </div>
<script src="/assets/search.js" defer></script>
</body>
</html>
